# ==============================================================================
# go.zulfifazhar.dev - Environment Variables Template
# ==============================================================================

# Application Base URL
# Local development: http://localhost:5173
# Production: https://go.zulfifazhar.dev
BASE_URL="http://localhost:5173"

# JWT Secret Key for HMAC-SHA256 session cookie signing
# Must be a secure random string of at least 32 characters
JWT_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Authorized redirect URIs to register in Google Console:
#   - http://localhost:5173/api/auth/callback (for local dev)
#   - https://go.zulfifazhar.dev/api/auth/callback (for production)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
